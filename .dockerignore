# Keep Docker and Podman build contexts minimal.
#
# Excludes VCS metadata, worktrees, test/CI output, databases, logs, and local
# build artifacts. `vendor/` is intentionally kept so the root Dockerfile can
# build offline with `go build -mod=vendor`.

.git
.gitignore
.ignore
.gocache
.agents/worktrees
.agents/skills
heaven
jobs
*.log
*.out
*.sqlite*
asimi
asimi_linux
coverage.*
test_tmp
profiles
dist
notes
tmp
.envrc
